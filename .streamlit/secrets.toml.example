# Copia aquest fitxer a .streamlit/secrets.toml i omple les dades.
# .streamlit/secrets.toml NO s'ha de pujar mai a GitHub (ja es al .gitignore).

[postgres]
# Connexio de Supabase (Project Settings -> Database -> Connection string -> URI)
url = "postgresql://USUARI:CONTRASENYA@HOST:5432/postgres?sslmode=require"

[auth]
# Contrasenya per entrar al tauler (deixa-la buida per no demanar res)
password = "la-meva-contrasenya-familiar"
